# Copy to .env and adjust. All values are optional in development.

PORT=3000

# Where the SQLite file lives (defaults to ./db/nextbuy.db)
# DB_PATH=./db/nextbuy.db

# Seed credentials for `npm run seed`
ADMIN_EMAIL=admin@nextbuy.in
ADMIN_PASSWORD=admin1234
DEMO_EMAIL=demo@nextbuy.in
DEMO_PASSWORD=demo1234

# Set to "true" only when serving over HTTPS
COOKIE_SECURE=false
